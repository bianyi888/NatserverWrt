# NatserverWrt CMCC RAX3000M eMMC + OAF 7.0.1 + dae/daed 专用配置
# 底座: hanwckf/immortalwrt-mt798x @ openwrt-21.02 (OpenWrt 21.02 / kernel 5.4 / target mediatek/mt7981)
# 插件: destan19/OpenAppFilter 7.0.1 (OAF) + kenzok8/openwrt-daede (dae/daed/luci-app-daede)
# 用法: cp config/rax3000m-emmc-oaf-daede.config openwrt/.config && make defconfig

# ===== Target =====
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7981=y
CONFIG_TARGET_mediatek_mt7981_DEVICE_cmcc_rax3000m-emmc=y
# 只编一个机型, 省时间省空间
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_TARGET_MULTI_PROFILE is not set

# ===== 固件命名 (对齐图中 OAF 固件名) =====
# -> immortalwrt-mt798x-21.02-oaf7.0.1-daed-mediatek-mt7981-cmcc_rax3000m-emmc-squashfs-sysupgrade.bin
CONFIG_VERSION_DIST="ImmortalWrt-mt798x"
CONFIG_VERSION_NUMBER="21.02-oaf7.0.1-daed"
CONFIG_VERSION_FILENAMES=y

# ===== 根文件系统 (emmc 走 sysupgrade-tar, 原厂 OAF 就是 squashfs) =====
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

# ===== 内核 eBPF / BTF (dae & daed 依赖) =====
# 注意: 21.02 的 config/Config-kernel.in 没有 KERNEL_DEBUG_INFO_BTF /
#       KERNEL_BPF_EVENTS / KERNEL_XDP_SOCKETS 这三个符号, 写了会被 defconfig 丢掉,
#       已在 scripts/rax3000m-diy-part2.sh 直接补进 target/linux/generic/config-5.4。
#       BPF_EVENTS 是 5.4 内核里的非提示符号(default y), 只要
#       KPROBE_EVENTS + PERF_EVENTS 满足就会自动打开, 所以这里开 KPROBE_EVENTS。
CONFIG_KERNEL_DEBUG_INFO=y
# 符号本身 21.02 的 Config-kernel.in 没有, 由 scripts/rax3000m-diy-part2.sh 补上
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_FTRACE=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_DEVEL=y

# ===== OAF 7.0.1 (OpenAppFilter) =====
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y

# ===== dae / daed (kenzok8/openwrt-daede) =====
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daede=y
# BTF 来源: 用内核自己的 CONFIG_DEBUG_INFO_BTF (diy-part2 已在 generic config 打开)。
# 21.02 的 Config-kernel.in 原本没有 KERNEL_DEBUG_INFO_BTF 符号, diy-part2 会补上,
# 否则 choice 会退到 vmlinux-btf —— 那要额外整棵树编一遍 shadow kernel, 又慢又容易挂。
CONFIG_DAE_USE_KERNEL_BTF=y
# CONFIG_DAE_USE_VMLINUX_BTF is not set
# CONFIG_PACKAGE_vmlinux-btf is not set
# dae/daed 用 netns + veth + cgroup eBPF 拦截, init 脚本里 "ip netns" 需要 ip-full
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_iptables-nft=y

# ===== 常用软件 =====
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# eMMC 版机型自带依赖 (mt7981.mk 的 DEVICE_PACKAGES), 这里显式列出便于核对
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_kmod-mmc=y
